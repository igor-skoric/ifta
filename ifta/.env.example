# Copy to .env on the server (never commit .env).

# Required for production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-generate-with-python-manage-py-shell
ALLOWED_HOSTS=ifta.rs.itbranch.rs,www.ifta.rs.itbranch.rs,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://ifta.rs.itbranch.rs,https://www.ifta.rs.itbranch.rs

# HTTPS behind reverse proxy (nginx / IIS)
DJANGO_USE_HTTPS=true
TRUST_X_FORWARDED_FOR=true
SECURE_SSL_REDIRECT=true

# Samsara
SAMSARA_API_TOKEN=

# Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service_account.json

# TV displays (pick one approach)
# 1) Allow office LAN IPs only (recommended)
STATISTICS_TV_ALLOWED_IPS=192.168.0.0/24,127.0.0.1
# 2) Shared secret — bookmark e.g. /statistics/1/?tv_token=YOUR_SECRET
# STATISTICS_TV_TOKEN=
# 3) Open read access (not recommended on public internet)
# STATISTICS_TV_PUBLIC_READ=false
